/* Ultra Shining Violet Dashboard Theme - Premium UI/UX */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #8b5cf6;
    --primary-light: #a78bfa;
    --primary-dark: #7c3aed;
    --secondary: #c084fc;
    --accent: #e9d5ff;
    --violet-glow: rgba(139, 92, 246, 0.6);
    --white: #ffffff;
    --dark: #1a0d2e;
    --dark-light: #2d1b4e;
}

@keyframes shimmer {
    0% { background-position: -1000px 0; }
    100% { background-position: 1000px 0; }
}

@keyframes glow-pulse {
    0%, 100% { box-shadow: 0 0 20px var(--violet-glow), 0 0 40px var(--violet-glow), 0 0 60px var(--violet-glow); }
    50% { box-shadow: 0 0 30px var(--violet-glow), 0 0 60px var(--violet-glow), 0 0 90px var(--violet-glow); }
}

@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
}

@keyframes rotate-glow {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

@keyframes gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
    background: linear-gradient(135deg, #0f0321 0%, #1a0d2e 25%, #2d1b4e 50%, #1a0d2e 75%, #0f0321 100%);
    background-size: 400% 400%;
    animation: gradient-shift 15s ease infinite;
    color: #ffffff;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
}

body::before {
    content: '';
    position: fixed;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: 
        radial-gradient(circle at 20% 50%, rgba(139, 92, 246, 0.15) 0%, transparent 40%),
        radial-gradient(circle at 80% 20%, rgba(192, 132, 252, 0.15) 0%, transparent 40%),
        radial-gradient(circle at 50% 80%, rgba(233, 213, 255, 0.1) 0%, transparent 40%);
    animation: rotate-glow 30s linear infinite;
    pointer-events: none;
}

/* Ultra Shining Navbar */
.navbar {
    background: linear-gradient(135deg, rgba(26, 13, 46, 0.95) 0%, rgba(45, 27, 78, 0.95) 100%);
    backdrop-filter: blur(20px);
    border-bottom: 2px solid;
    border-image: linear-gradient(90deg, transparent, var(--primary), var(--secondary), transparent) 1;
    padding: 1.5rem 0;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 8px 32px rgba(139, 92, 246, 0.4), 0 0 60px rgba(139, 92, 246, 0.2);
}

.navbar::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
    animation: shimmer 3s infinite;
}

.nav-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 1;
}

.nav-logo h1 {
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.5px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3), 0 0 30px rgba(139, 92, 246, 0.5);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

.nav-company {
    font-size: 1.5rem;
    font-weight: 700;
    color: #e9d5ff;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4), 0 0 20px rgba(139, 92, 246, 0.6);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* Container */
.container {
    max-width: 1400px;
    margin: 3rem auto;
    padding: 0 2rem;
    display: flex;
    gap: 2rem;
    position: relative;
    z-index: 1;
}

/* Ultra Glowing Sidebar */
.sidebar {
    width: 300px;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1) 0%, rgba(192, 132, 252, 0.05) 100%);
    backdrop-filter: blur(20px);
    border-radius: 24px;
    padding: 2rem;
    border: 2px solid rgba(139, 92, 246, 0.3);
    box-shadow: 
        0 8px 32px rgba(139, 92, 246, 0.3),
        inset 0 0 60px rgba(139, 92, 246, 0.1);
    position: relative;
    overflow: hidden;
    animation: glow-pulse 3s ease-in-out infinite;
}

.sidebar::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: conic-gradient(from 0deg, transparent, var(--primary), transparent);
    animation: rotate-glow 4s linear infinite;
    opacity: 0.3;
}

.sidebar::after {
    content: '';
    position: absolute;
    inset: 2px;
    background: linear-gradient(135deg, rgba(26, 13, 46, 0.8) 0%, rgba(45, 27, 78, 0.6) 100%);
    border-radius: 22px;
    z-index: 0;
}

.nav-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    z-index: 1;
}

.nav-links a {
    display: flex;
    align-items: center;
    padding: 1.25rem 1.5rem;
    color: #ffffff;
    text-decoration: none;
    border-radius: 16px;
    font-weight: 600;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    border: 1px solid transparent;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

.nav-links a::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 4px;
    height: 0;
    background: linear-gradient(180deg, var(--primary), var(--secondary));
    transition: all 0.4s ease;
    box-shadow: 0 0 20px var(--violet-glow);
}

.nav-links a::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    opacity: 0;
    transition: opacity 0.4s ease;
}

.nav-links a:hover::before {
    height: 100%;
    top: 0;
}

.nav-links a:hover {
    transform: translateX(10px);
    border-color: var(--primary);
    box-shadow: 0 8px 32px var(--violet-glow);
}

.nav-links a:hover::after {
    opacity: 0.1;
}

.nav-links a.active {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    box-shadow: 
        0 8px 32px var(--violet-glow),
        inset 0 0 20px rgba(255,255,255,0.2);
    animation: glow-pulse 2s ease-in-out infinite;
}

.nav-links a.active::before {
    height: 100%;
    top: 0;
    background: var(--white);
}

/* Main Content with Ultra Glass Effect */
.main-content {
    flex: 1;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.08) 0%, rgba(192, 132, 252, 0.04) 100%);
    backdrop-filter: blur(20px);
    border-radius: 24px;
    padding: 3rem;
    border: 2px solid rgba(139, 92, 246, 0.3);
    box-shadow: 
        0 8px 32px rgba(139, 92, 246, 0.3),
        inset 0 0 80px rgba(139, 92, 246, 0.05);
    position: relative;
    overflow: hidden;
}

.main-content::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05), transparent);
    animation: shimmer 4s infinite;
}

/* Page Header with Glow */
.page-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid;
    border-image: linear-gradient(90deg, var(--primary), var(--secondary), transparent) 1;
    position: relative;
}

.page-header h2 {
    font-size: 2.5rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 1rem;
    letter-spacing: -0.5px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

.page-header p {
    color: rgba(255,255,255,0.95);
    font-size: 1.1rem;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* Ultra Shining Stats Grid */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
}

.stat-card {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, rgba(192, 132, 252, 0.08) 100%);
    backdrop-filter: blur(20px);
    padding: 2.5rem;
    border-radius: 20px;
    border: 2px solid rgba(139, 92, 246, 0.3);
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    animation: float 6s ease-in-out infinite;
}

.stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--primary), var(--secondary), var(--primary-light));
    background-size: 200% 100%;
    animation: gradient-shift 2s linear infinite;
    box-shadow: 0 0 20px var(--violet-glow);
}

.stat-card::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, var(--violet-glow) 0%, transparent 70%);
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.4s ease;
}

.stat-card:hover {
    transform: translateY(-15px) scale(1.05);
    box-shadow: 
        0 20px 60px var(--violet-glow),
        0 0 80px var(--violet-glow),
        inset 0 0 40px rgba(139, 92, 246, 0.2);
    border-color: var(--primary);
}

.stat-card:hover::after {
    opacity: 0.3;
    animation: rotate-glow 3s linear infinite;
}

.stat-card h3 {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #e9d5ff;
    margin-bottom: 1rem;
    font-weight: 700;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

.stat-card .stat-value {
    font-size: 3.5rem;
    font-weight: 900;
    color: #ffffff;
    line-height: 1;
    position: relative;
    z-index: 1;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

.stat-card .stat-label {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.9);
    margin-top: 0.75rem;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}
/* Glowing Cards */
.card {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1) 0%, rgba(192, 132, 252, 0.05) 100%);
    backdrop-filter: blur(20px);
    padding: 2.5rem;
    border-radius: 20px;
    border: 2px solid rgba(139, 92, 246, 0.3);
    margin-bottom: 2rem;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
}

.card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
    transition: left 0.6s ease;
}

.card:hover::before {
    left: 100%;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 50px var(--violet-glow);
    border-color: var(--primary);
}

.card h3 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 1.5rem;
    text-shadow: 0 0 20px var(--violet-glow);
}

/* Premium Forms */
.form-group#ffffff;
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 8px rgba(139, 92, 246, 0.6

.form-group label {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--primary-light);
    font-weight: 600;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}
#e9d5ff;
    font-weight: 600;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5)
    padding: 1rem 1.5rem;
    background: rgba(139, 92, 246, 0.1);
    border: 2px solid rgba(139, 92, 246, 0.3);
    border-radius: 12px;
    color: var(--white);
    font-size: 1rem;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 
        0 0 30px var(--violet-glow),
        inset 0 0 20px rgba(139, 92, 246, 0.1);
    background: rgba(139, 92, 246, 0.15);
}

.form-group textarea {
    min-height: 150px;
    resize: vertical;
}

/* Ultra Shining Buttons */
.btn {
    padding: 1rem 2.5rem;
    border: none;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    text-transform: uppercase;
    letter-spacing: 1px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
}

.btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    transition: left 0.6s ease;
}

.btn:hover::before {
    left: 100%;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    color: var(--white);
    box-shadow: 0 8px 32px var(--violet-glow);
    border: 2px solid var(--primary-light);
}

.btn-primary:hover {
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 15px 60px var(--violet-glow), 0 0 80px var(--violet-glow);
    animation: glow-pulse 1s ease-in-out infinite;
}

.btn-secondary {
    background: rgba(139, 92, 246, 0.2);
    color: var(--white);
    border: 2px solid var(--primary);
    backdrop-filter: blur(10px);
}

.btn-secondary:hover {
    background: rgba(139, 92, 246, 0.3);
    transform: translateY(-3px);
    box-shadow: 0 10px 40px var(--violet-glow);
}

.btn-success {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: var(--white);
}

.btn-danger {
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    color: var(--white);
}

/* Glowing Tables */
.table-container {
    border-radius: 16px;
    overflow: hidden;
    border: 2px solid rgba(139, 92, 246, 0.3);
    box-shadow: 0 8px 32px rgba(139, 92, 246, 0.2);
}

table {
    width: 100%;
    border-collapse: collapse;
}

thead {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    box-shadow: 0 4px 20px var(--violet-glow);
}

thead th {
    padding: 1.5rem;
    text-align: left;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-size: 0.85rem;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

tbody tr {
    background: rgba(139, 92, 246, 0.05);
    border-bottom: 1px solid rgba(139, 92, 246, 0.2);
    transition: all 0.3s ease;
}

tbody tr:hover {
    background: rgba(139, 92, 246, 0.15);
    box-shadow: inset 0 0 30px rgba(139, 92, 246, 0.2);
}

tbody td {
    padding: 1.5rem;
    color: var(--white);
}

/* Glowing Badges */
.badge {
    display: inline-block;
    paddingrgba(255, 255, 255, 0.95);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.325rem;
    border-radius: 25px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.badge-primary {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    color: var(--white);
    box-shadow: 0 4px 20px var(--violet-glow);
}

.badge-success {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: var(--white);
}

.badge-warning {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: var(--white);
}

/* Glowing Alerts */
.alert {
    padding: 1.5rem 2rem;
    border-radius: 12px;
    margin-bottom: 2rem;
    border-left: 4px solid;
    font-weight: 500;
    backdrop-filter: blur(10px);
}

.alert-success {
    background: rgba(16, 185, 129, 0.15);
    border-color: #10b981;
    color: #6ee7b7;
}

.alert-error {
    background: rgba(239, 68, 68, 0.15);
    border-color: #ef4444;
    color: #fca5a5;
}

.alert-info {
    background: rgba(139, 92, 246, 0.15);
    border-color: var(--primary);
    color: var(--primary-light);
}

/* Glowing Spinner */
.loading {
    width: 24px;
    height: 24px;
    border: 3px solid rgba(139, 92, 246, 0.3);
    border-top-color: var(--primary);
    border-radius: 50%;
    display: inline-block;
    width: 24px;
    height: 24px;
    border: 3px solid rgba(139, 92, 246, 0.3);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    box-shadow: 0 0 30px var(--violet-glow);
    vertical-align: middle;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

/* Fix for buttons with loading state */
.btn .loading {
    margin-right: 8px;
}

.btn-loading {
    positio#ffffff;
    margin-bottom: 1rem;
    text-shadow: 0 2px 8px rgba(139, 92, 246, 0.6);
}

.empty-state p {
    color: rgba(255,255,255,0.85);
    font-size: 1.1rem;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3)
    height: 20px;
    top: 50%;
    left: 50%;
    margin-left: -10px;
    margin-top: -10px;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-#e9d5ff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5
    animation: spin 0.8s linear infinite;
    padding: 5rem 2rem;
}

.empty-state h3 {
    font-size: 1.75rem;
    color: var(--white);
    margin-bottom: 1rem;
    text-shadow: 0 0 20px var(--violet-glow);
}

.empty-state p {
    color: rgba(255,255,255,0.6);
    font-size: 1.1rem;
}

/* Glowing Code Blocks */
pre {
    background: linear-gradient(135deg, rgba(26, 13, 46, 0.9) 0%, rgba(45, 27, 78, 0.8) 100%);
    padding: 2rem;
    border-radius: 12px;
    border: 2px solid rgba(139, 92, 246, 0.3);
    overflow-x: auto;
    margin: 2rem 0;
    box-shadow: 0 8px 32px rgba(139, 92, 246, 0.3);
    color: var(--primary-light);
}

code {
    font-family: 'Fira Code', 'Courier New', monospace;
}

/* Glowing Scrollbar */
::-webkit-scrollbar {
    width: 12px;
    height: 12px;
}
rgba(255, 255, 255, 0.95);
    border-radius: 12px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.3s ease;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5)
::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    border-radius: 10px;
    box-shadow: 0 0 20px var(--violet-glow);
}

::-webkit-scrollbar-thumb:hover {
    box-shadow: 0 0 40px var(--violet-glow);
}

/* Tabs */
.tabs {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
}

.tab-btn {
    padding: 1rem 2rem;
    background: rgba(139, 92, 246, 0.1);
    border: 2px solid rgba(139, 92, 246, 0.3);
    color: var(--white);
    border-radius: 12px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.3s ease;
}85);
    text-transform: uppercase;
    letter-spacing: 1px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3)
    background: rgba(139, 92, 246, 0.2);
    border-color: var(--primary);
}

.tab-btn.active {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    border-color: var(--primary-light);
    box-shadow: 0 8px 32px var(--violet-glow);
}
#ffffff;
    font-weight: 700;
    text-shadow: 0 2px 8px rgba(139, 92, 246, 0.6
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
}

.info-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.info-label {
    font-size: 0.9rem;
    color: #ffffff;
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 8px rgba(139, 92, 246, 0.6
}

.info-value {
    font-size: 1.25rem;
    color: var(--primary-light);
    font-weight: 700;
    text-shadow: 0 0 20px var(--violet-glow);
}

.status-active {
    color: #10b981 !important;
}

.section {
    margin-bottom: 3rem;
}

.section h3 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 1.5rem;
    text-shadow: 0 0 20px var(--violet-glow);
}

/* Responsive */
@media (max-width: 1024px) {
    .container {
        flex-direction: column;
    }
    
    .sidebar {
        width: 100%;
    }
    
    .nav-links {
        flex-direction: row;
        flex-wrap: wrap;
    }
}

@media (max-width: 768px) {
    .nav-container {
        flex-direction: column;
        gap: 1rem;
    }
    
    .stats-grid {
        grid-template-columns: 1fr;
    }
    
    .page-header h2 {
        font-size: 2rem;
    }
}
